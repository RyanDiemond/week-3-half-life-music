  <main name="MIDI_Keypad_Logic"/>
  <options><a name="gateUndefined" val="ignore"/><a name="simlimit" val="1000"/></options>
  <mappings>
    <tool lib="0" name="Pin" map="Button2"/>
    <tool lib="0" name="Pin" map="Button3"/>
  </mappings>
  <toolbar>
    <tool lib="0" name="Pin"/><tool lib="0" name="Probe"/><tool lib="1" name="AND Gate"/>
  </toolbar>
  <!-- Simulation scope and unsupported hardware:
       The KiCad netlist describes connectivity only; it contains no firmware/behavioral logic.
       XIAO ESP32-S3 is represented only by its connected GPIO nets, not by a CPU model.
       SK6812MINI-E pixels are abstracted as serial data-chain pass-through test nets; RGB/PWM
       timing and color decoding are not simulated. RV1 is represented as a 1-bit digital
       stimulus, not an analog potentiometer. Power rails (+3V3, +5V) and GND are not modeled
       as logic signals. Rotary encoder push switch S1/S2 are unconnected in the source netlist.
       This file is a connectivity/logic test scaffold, not a faithful functional firmware model.
  -->
  <circuit name="MIDI_Keypad_Logic">
    <a name="circuit" val="MIDI_Keypad_Logic"/>
